{
  "name": "dsh-plugin-infinite-retry",
  "version": "1.0.0",
  "description": "Infinite retry for failed DeepSeek Harness model requests, including subagents.",
  "author": "Tokenav",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/JnmLee/dsh-plugin-infinite-retry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JnmLee/dsh-plugin-infinite-retry.git"
  },
  "bugs": {
    "url": "https://github.com/JnmLee/dsh-plugin-infinite-retry/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "retry",
    "infinite-retry",
    "subagent"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
